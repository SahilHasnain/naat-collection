{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.12.0"
    },
    "all": {
      "env": {
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_AUTH_TOKEN": "@SENTRY_AUTH_TOKEN",
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1",
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_AUTH_TOKEN": "@SENTRY_AUTH_TOKEN",
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1",
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "autoIncrement": false,
      "credentialsSource": "local",
      "env": {
        "SENTRY_AUTH_TOKEN": "@SENTRY_AUTH_TOKEN",
        "EXPO_USE_METRO_WORKSPACE_ROOT": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
